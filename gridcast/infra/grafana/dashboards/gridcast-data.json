    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Forecast vs actual (from PostgreSQL)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "System load: published forecast (p10/p50/p90) vs actual",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gridcast-db"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "MW",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gridcast-db"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT date_trunc('hour', ts) AS time, sum(load_mw)/count(DISTINCT date_trunc('minute', ts)) * 1 AS actual_mw FROM (SELECT ts, sum(load_mw) AS load_mw FROM raw.demand_readings WHERE $__timeFilter(ts) GROUP BY ts) s GROUP BY 1 ORDER BY 1"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gridcast-db"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT f.target_ts AS time, sum(f.load_mw_p50) AS forecast_p50, sum(f.load_mw_p10) AS forecast_p10, sum(f.load_mw_p90) AS forecast_p90 FROM planning.dispatch_plans p JOIN ml.forecasts f USING (forecast_run_id) WHERE p.status = 'active' GROUP BY 1 ORDER BY 1"
    }
   ]
  },
  {
   "id": 3,
   "type": "table",
   "title": "Model registry",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gridcast-db"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gridcast-db"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT m.version, m.profile, m.algorithm, round((m.metrics->>'mape_p50')::numeric,4) AS holdout_mape, round((m.metrics->>'coverage_p10_p90')::numeric,3) AS coverage, string_agg(a.alias, ',') AS aliases, m.created_by, m.created_at FROM ml.models m LEFT JOIN ml.model_aliases a USING (model_name, version) GROUP BY m.model_name, m.version ORDER BY m.version DESC"
    }
   ]
  },
  {
   "id": 4,
   "type": "table",
   "title": "Model registry events",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gridcast-db"
   },
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gridcast-db"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT at, event, alias, version, previous_version, actor, reason FROM ml.model_events ORDER BY at DESC LIMIT 20"
    }
   ]
  },
  {
