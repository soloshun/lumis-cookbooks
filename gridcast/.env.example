# GridCast local environment. Copy to `.env` (`make env`) — values below are local-only dev
# defaults and are safe to keep for a laptop estate. Never reuse them anywhere real.

# --- Host ports for the platform (docker compose) -----------------------------------------
POSTGRES_PORT=5432
PGADMIN_PORT=5050
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
PREFECT_PORT=4200
S3_PORT=8333
S3_MASTER_UI_PORT=9333
S3_FILER_UI_PORT=8888
S3_ADMIN_UI_PORT=23646
REGISTRY_PORT=5001

# --- PostgreSQL --------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local-admin
GRIDCAST_OWNER_PASSWORD=owner-local
GRIDCAST_INGEST_PASSWORD=ingest-local
GRIDCAST_APP_PASSWORD=app-local
GRIDCAST_PLANNING_PASSWORD=planning-local
GRIDCAST_PIPELINE_PASSWORD=pipeline-local
GRIDCAST_READONLY_PASSWORD=readonly-local
PREFECT_DB_PASSWORD=prefect-local

# --- Object storage (SeaweedFS S3 API) for model artifacts -----------------------------------
S3_ACCESS_KEY=gridcast
S3_SECRET_KEY=gridcast-local-secret
S3_BUCKET=gridcast-models

# --- UIs ----------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
PGADMIN_EMAIL=admin@gridcast.dev
PGADMIN_PASSWORD=admin
S3_ADMIN_PASSWORD=admin

# --- Vendor simulators ----------------------------------------------------------------------
# Admin token for the vendor fault APIs used by `gridcastctl chaos`. Vendors are external
# systems: Lumis is never given this token.
VENDOR_ADMIN_TOKEN=vendor-admin-local
# hybrid = real Open-Meteo weather with synthetic fallback; synthetic = fully offline.
WEATHER_TRUTH_MODE=hybrid

# --- Pipeline cadence ----------------------------------------------------------------------
FORECAST_INTERVAL_SECONDS=300

# --- LLM access for Lumis (used by the Lumis integration, not by GridCast itself) ------------
# OpenRouter exposes many models behind one OpenAI-compatible API. The model id is required.
# Default is a very cheap model with structured-output support, good for wiring tests
# (`gridcastctl llm check`). Cheap alternatives: google/gemini-2.5-flash-lite (fastest),
# mistralai/mistral-small-24b-instruct-2501. Use a stronger model for real diagnosis runs.
# Tested 2026-10-03: openai/gpt-oss-20b returned malformed structured output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
